{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "_meta": {
    "flowName": "Shared-StablecoinEmailFlow",
    "description": "Shared Power Automate flow. Accepts an HTML body, subject line, and recipient lists, then sends the email via Office 365 Outlook. Can be called by any Copilot Studio agent or flow that needs to distribute HTML reports.",
    "version": "1.0.0",
    "sharedWith": "All agents in the Copilot Studio environment",
    "connector": "Office 365 Outlook (shared connection — connection name: shared_o365_outlook)"
  },

  "trigger": {
    "type": "Request",
    "kind": "Http",
    "description": "HTTP trigger so any agent or flow can call this as a child flow or via HTTP action.",
    "inputs": {
      "schema": {
        "type": "object",
        "required": ["htmlBody", "subject"],
        "properties": {
          "htmlBody": {
            "type": "string",
            "description": "Fully rendered HTML email body (output of Shared-FormatStablecoinReport or any compatible formatter)"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line"
          },
          "to": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Primary recipients. Falls back to default list if omitted.",
            "default": [
              "analyst1@yourorg.com",
              "analyst2@yourorg.com",
              "portfoliomanager@yourorg.com"
            ]
          },
          "cc": {
            "type": "array",
            "items": { "type": "string" },
            "description": "CC recipients. Falls back to default list if omitted.",
            "default": [
              "compliance@yourorg.com",
              "research-team@yourorg.com"
            ]
          },
          "senderDisplayName": {
            "type": "string",
            "description": "Optional display name for the From field.",
            "default": "Stablecoin Research Agent"
          }
        }
      }
    }
  },

  "actions": {

    "Initialize_DefaultTo": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{
          "name": "resolvedTo",
          "type": "array",
          "value": "@if(empty(triggerBody()?['to']), createArray('analyst1@yourorg.com', 'analyst2@yourorg.com', 'portfoliomanager@yourorg.com'), triggerBody()?['to'])"
        }]
      }
    },

    "Initialize_DefaultCc": {
      "type": "InitializeVariable",
      "runAfter": { "Initialize_DefaultTo": ["Succeeded"] },
      "inputs": {
        "variables": [{
          "name": "resolvedCc",
          "type": "array",
          "value": "@if(empty(triggerBody()?['cc']), createArray('compliance@yourorg.com', 'research-team@yourorg.com'), triggerBody()?['cc'])"
        }]
      }
    },

    "Build_To_String": {
      "type": "Compose",
      "runAfter": { "Initialize_DefaultCc": ["Succeeded"] },
      "inputs": "@join(variables('resolvedTo'), ';')"
    },

    "Build_Cc_String": {
      "type": "Compose",
      "runAfter": { "Build_To_String": ["Succeeded"] },
      "inputs": "@join(variables('resolvedCc'), ';')"
    },

    "Send_Email_via_Outlook": {
      "type": "ApiConnection",
      "runAfter": { "Build_Cc_String": ["Succeeded"] },
      "inputs": {
        "host": {
          "connection": { "name": "@parameters('$connections')['shared_o365_outlook']['connectionId']" }
        },
        "method": "post",
        "path": "/v2/Mail",
        "body": {
          "To":                  "@outputs('Build_To_String')",
          "Cc":                  "@outputs('Build_Cc_String')",
          "Subject":             "@triggerBody()?['subject']",
          "Body":                "@triggerBody()?['htmlBody']",
          "IsHtml":              true,
          "Importance":          "Normal",
          "SenderDisplayName":   "@coalesce(triggerBody()?['senderDisplayName'], 'Stablecoin Research Agent')"
        }
      }
    },

    "Log_Success": {
      "type": "Compose",
      "runAfter": { "Send_Email_via_Outlook": ["Succeeded"] },
      "inputs": {
        "status":    "sent",
        "to":        "@outputs('Build_To_String')",
        "cc":        "@outputs('Build_Cc_String')",
        "subject":   "@triggerBody()?['subject']",
        "timestamp": "@utcNow()"
      }
    },

    "Respond_Success": {
      "type": "Response",
      "runAfter": { "Log_Success": ["Succeeded"] },
      "inputs": {
        "statusCode": 200,
        "body": "@outputs('Log_Success')"
      }
    },

    "Handle_Send_Failure": {
      "type": "Compose",
      "runAfter": { "Send_Email_via_Outlook": ["Failed", "TimedOut"] },
      "inputs": {
        "status":    "failed",
        "error":     "@actions('Send_Email_via_Outlook')?['error']",
        "timestamp": "@utcNow()"
      }
    },

    "Respond_Failure": {
      "type": "Response",
      "runAfter": { "Handle_Send_Failure": ["Succeeded"] },
      "inputs": {
        "statusCode": 500,
        "body": "@outputs('Handle_Send_Failure')"
      }
    }
  },

  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  }
}
