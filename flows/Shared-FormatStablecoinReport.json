{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "_meta": {
    "flowName": "Shared-FormatStablecoinReport",
    "description": "Accepts structured stablecoin research JSON and returns a fully rendered HTML email body using the stablecoin-report template. Designed to be called by any Copilot Studio agent or Power Automate flow.",
    "version": "1.0.0",
    "sharedWith": "All agents in the Copilot Studio environment"
  },

  "trigger": {
    "type": "Request",
    "kind": "Http",
    "inputs": {
      "schema": {
        "type": "object",
        "required": ["reportDate", "windowStart", "windowEnd", "coins", "newsItems", "executiveSummary", "macroContext"],
        "properties": {
          "reportDate":        { "type": "string", "description": "Human-readable date, e.g. 'May 15, 2026'" },
          "windowStart":       { "type": "string", "description": "ISO 8601 start of 24h window, e.g. '2026-05-14T07:00:00Z'" },
          "windowEnd":         { "type": "string", "description": "ISO 8601 end of 24h window" },
          "generatedAt":       { "type": "string", "description": "ISO 8601 timestamp of report generation" },
          "executiveSummary":  { "type": "string", "description": "1-3 sentence plain-text summary" },
          "macroContext":      { "type": "string", "description": "Plain-text macro context paragraph" },
          "coins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "ticker", "priceUsd", "pegDeltaPct", "marketCapUsd", "capDelta24hPct", "volume24hUsd"],
              "properties": {
                "name":           { "type": "string" },
                "ticker":         { "type": "string" },
                "priceUsd":       { "type": "number" },
                "pegDeltaPct":    { "type": "number", "description": "Deviation from $1.00, e.g. 0.01 = +0.01%" },
                "marketCapUsd":   { "type": "number" },
                "capDelta24hPct": { "type": "number" },
                "volume24hUsd":   { "type": "number" }
              }
            }
          },
          "newsItems": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "source", "publishedAt", "body", "category"],
              "properties": {
                "title":       { "type": "string" },
                "source":      { "type": "string" },
                "publishedAt": { "type": "string", "description": "Human-readable, e.g. 'May 15, 2026 14:32 UTC'" },
                "body":        { "type": "string" },
                "category":    {
                  "type": "string",
                  "enum": ["regulatory", "protocol", "market"],
                  "description": "Controls badge color and icon"
                }
              }
            }
          }
        }
      }
    }
  },

  "actions": {

    "Initialize_CoinRows": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{ "name": "coinRowsHtml", "type": "string", "value": "" }]
      }
    },

    "Initialize_NewsHtml": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{ "name": "newsItemsHtml", "type": "string", "value": "" }]
      },
      "runAfter": { "Initialize_CoinRows": ["Succeeded"] }
    },

    "Build_Coin_Rows": {
      "type": "Apply_to_each",
      "foreach": "@triggerBody()?['coins']",
      "runAfter": { "Initialize_NewsHtml": ["Succeeded"] },
      "actions": {
        "Compute_PegClass": {
          "type": "Compose",
          "inputs": "@if(less(abs(items('Build_Coin_Rows')?['pegDeltaPct']), 0.1), 'peg-ok', if(less(abs(items('Build_Coin_Rows')?['pegDeltaPct']), 0.5), 'peg-warn', 'peg-alert'))"
        },
        "Compute_PegLabel": {
          "type": "Compose",
          "runAfter": { "Compute_PegClass": ["Succeeded"] },
          "inputs": "@if(less(abs(items('Build_Coin_Rows')?['pegDeltaPct']), 0.1), 'Stable', if(less(abs(items('Build_Coin_Rows')?['pegDeltaPct']), 0.5), 'Watch', 'Alert'))"
        },
        "Compute_CapClass": {
          "type": "Compose",
          "runAfter": { "Compute_PegLabel": ["Succeeded"] },
          "inputs": "@if(greaterOrEquals(items('Build_Coin_Rows')?['capDelta24hPct'], 0), 'cap-up', 'cap-down')"
        },
        "Format_PegDelta": {
          "type": "Compose",
          "runAfter": { "Compute_CapClass": ["Succeeded"] },
          "inputs": "@concat(if(greaterOrEquals(items('Build_Coin_Rows')?['pegDeltaPct'], 0), '+', ''), string(items('Build_Coin_Rows')?['pegDeltaPct']), '%')"
        },
        "Format_CapDelta": {
          "type": "Compose",
          "runAfter": { "Format_PegDelta": ["Succeeded"] },
          "inputs": "@concat(if(greaterOrEquals(items('Build_Coin_Rows')?['capDelta24hPct'], 0), '+', ''), string(items('Build_Coin_Rows')?['capDelta24hPct']), '%')"
        },
        "Build_Row_Html": {
          "type": "Compose",
          "runAfter": { "Format_CapDelta": ["Succeeded"] },
          "inputs": "@concat('<tr><td><span class=\"coin-name\">', items('Build_Coin_Rows')?['name'], '</span><span class=\"coin-ticker\">', items('Build_Coin_Rows')?['ticker'], '</span></td><td>$', string(items('Build_Coin_Rows')?['priceUsd']), '</td><td class=\"', outputs('Compute_PegClass'), '\">', outputs('Format_PegDelta'), '</td><td>$', string(div(items('Build_Coin_Rows')?['marketCapUsd'], 1000000000)), ' B</td><td class=\"', outputs('Compute_CapClass'), '\">', outputs('Format_CapDelta'), '</td><td>$', string(div(items('Build_Coin_Rows')?['volume24hUsd'], 1000000000)), ' B</td><td class=\"', outputs('Compute_PegClass'), '\">', outputs('Compute_PegLabel'), '</td></tr>')"
        },
        "Append_Row": {
          "type": "AppendToStringVariable",
          "runAfter": { "Build_Row_Html": ["Succeeded"] },
          "inputs": {
            "name": "coinRowsHtml",
            "value": "@outputs('Build_Row_Html')"
          }
        }
      }
    },

    "Build_News_Items": {
      "type": "Apply_to_each",
      "foreach": "@triggerBody()?['newsItems']",
      "runAfter": { "Build_Coin_Rows": ["Succeeded"] },
      "actions": {
        "Compute_Badge": {
          "type": "Compose",
          "inputs": "@if(equals(items('Build_News_Items')?['category'], 'regulatory'), '<span class=\"badge-regulatory\">&#9888; Regulatory</span>', if(equals(items('Build_News_Items')?['category'], 'protocol'), '<span class=\"badge-protocol\">Protocol</span>', '<span class=\"badge-market\">Market</span>'))"
        },
        "Build_News_Html": {
          "type": "Compose",
          "runAfter": { "Compute_Badge": ["Succeeded"] },
          "inputs": "@concat('<div class=\"news-item\"><p class=\"news-title\">', outputs('Compute_Badge'), items('Build_News_Items')?['title'], '</p><p class=\"news-meta\">Source: ', items('Build_News_Items')?['source'], ' &nbsp;&middot;&nbsp; ', items('Build_News_Items')?['publishedAt'], '</p><p class=\"news-body\">', items('Build_News_Items')?['body'], '</p></div>')"
        },
        "Append_News": {
          "type": "AppendToStringVariable",
          "runAfter": { "Build_News_Html": ["Succeeded"] },
          "inputs": {
            "name": "newsItemsHtml",
            "value": "@outputs('Build_News_Html')"
          }
        }
      }
    },

    "Load_HTML_Template": {
      "type": "Compose",
      "runAfter": { "Build_News_Items": ["Succeeded"] },
      "comment": "In production, load via SharePoint/Blob connector. Inline here for portability.",
      "inputs": "<!-- TEMPLATE_PLACEHOLDER: replace with SharePoint Get File connector targeting /templates/stablecoin-report.html -->"
    },

    "Inject_Template_Variables": {
      "type": "Compose",
      "runAfter": { "Load_HTML_Template": ["Succeeded"] },
      "inputs": {
        "htmlBody": "@replace(replace(replace(replace(replace(replace(replace(replace(string(outputs('Load_HTML_Template')), '{{REPORT_DATE}}', triggerBody()?['reportDate']), '{{WINDOW_START}}', triggerBody()?['windowStart']), '{{WINDOW_END}}', triggerBody()?['windowEnd']), '{{GENERATED_AT}}', triggerBody()?['generatedAt']), '{{COIN_COUNT}}', string(length(triggerBody()?['coins']))), '{{EXECUTIVE_SUMMARY}}', triggerBody()?['executiveSummary']), '{{COIN_ROWS}}', variables('coinRowsHtml')), '{{NEWS_ITEMS}}', variables('newsItemsHtml'))",
        "macroReplaced": "@replace(outputs('Inject_Template_Variables')?['htmlBody'], '{{MACRO_CONTEXT}}', triggerBody()?['macroContext'])"
      }
    },

    "Respond_With_HTML": {
      "type": "Response",
      "runAfter": { "Inject_Template_Variables": ["Succeeded"] },
      "inputs": {
        "statusCode": 200,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "htmlBody": "@outputs('Inject_Template_Variables')?['macroReplaced']",
          "coinCount": "@length(triggerBody()?['coins'])",
          "newsCount": "@length(triggerBody()?['newsItems'])"
        }
      }
    }
  }
}
