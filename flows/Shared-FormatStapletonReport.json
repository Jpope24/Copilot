{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "_meta": {
    "flowName": "Shared-FormatStapletonReport",
    "description": "Accepts structured Stapleton community research JSON and returns a fully rendered HTML email body using the stapleton-report template. Designed to be called by any Copilot Studio agent or Power Automate flow.",
    "version": "1.0.0",
    "sharedWith": "All agents in the Copilot Studio environment"
  },

  "trigger": {
    "type": "Request",
    "kind": "Http",
    "inputs": {
      "schema": {
        "type": "object",
        "required": ["reportDate", "windowStart", "windowEnd", "executiveSummary", "developments", "realEstateSnapshot"],
        "properties": {
          "reportDate":        { "type": "string", "description": "Human-readable date, e.g. 'May 16, 2026'" },
          "windowStart":       { "type": "string", "description": "ISO 8601 start of 24h window" },
          "windowEnd":         { "type": "string", "description": "ISO 8601 end of 24h window" },
          "generatedAt":       { "type": "string", "description": "ISO 8601 generation timestamp" },
          "executiveSummary":  { "type": "string" },
          "developments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "title", "description", "source", "publishedAt", "impact"],
              "properties": {
                "category":    { "type": "string", "enum": ["real-estate", "infrastructure", "community", "business", "safety", "government"] },
                "title":       { "type": "string" },
                "description": { "type": "string" },
                "source":      { "type": "string" },
                "publishedAt": { "type": "string" },
                "impact":      { "type": "string", "enum": ["high", "medium", "low"] }
              }
            }
          },
          "realEstateSnapshot": {
            "type": "object",
            "required": ["medianListPrice", "priceChangePct", "activeListings", "listingsChangePct", "avgDaysOnMarket", "newListings24h"],
            "properties": {
              "medianListPrice":   { "type": "number" },
              "priceChangePct":    { "type": "number" },
              "activeListings":    { "type": "number" },
              "listingsChangePct": { "type": "number" },
              "avgDaysOnMarket":   { "type": "number" },
              "newListings24h":    { "type": "number" }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "date", "location"],
              "properties": {
                "title":       { "type": "string" },
                "date":        { "type": "string", "description": "Human-readable, e.g. 'May 20, 2026'" },
                "location":    { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },

  "actions": {

    "Initialize_DevItemsHtml": {
      "type": "InitializeVariable",
      "inputs": { "variables": [{ "name": "devItemsHtml", "type": "string", "value": "" }] }
    },

    "Initialize_EventItemsHtml": {
      "type": "InitializeVariable",
      "inputs": { "variables": [{ "name": "eventItemsHtml", "type": "string", "value": "" }] },
      "runAfter": { "Initialize_DevItemsHtml": ["Succeeded"] }
    },

    "Build_Development_Items": {
      "type": "Apply_to_each",
      "foreach": "@triggerBody()?['developments']",
      "runAfter": { "Initialize_EventItemsHtml": ["Succeeded"] },
      "actions": {
        "Compute_CategoryBadge": {
          "type": "Compose",
          "inputs": "@if(equals(items('Build_Development_Items')?['category'], 'real-estate'), '<span class=\"badge badge-real-estate\">Real Estate</span>', if(equals(items('Build_Development_Items')?['category'], 'infrastructure'), '<span class=\"badge badge-infrastructure\">Infrastructure</span>', if(equals(items('Build_Development_Items')?['category'], 'community'), '<span class=\"badge badge-community\">Community</span>', if(equals(items('Build_Development_Items')?['category'], 'business'), '<span class=\"badge badge-business\">Business</span>', if(equals(items('Build_Development_Items')?['category'], 'safety'), '<span class=\"badge badge-safety\">&#9888; Safety</span>', '<span class=\"badge badge-government\">Government</span>')))))"
        },
        "Compute_ImpactLabel": {
          "type": "Compose",
          "runAfter": { "Compute_CategoryBadge": ["Succeeded"] },
          "inputs": "@if(equals(items('Build_Development_Items')?['impact'], 'high'), '<span class=\"impact-high\">&#9650; High Impact</span>', if(equals(items('Build_Development_Items')?['impact'], 'medium'), '<span class=\"impact-medium\">&#9654; Medium Impact</span>', '<span class=\"impact-low\">&#9658; Low Impact</span>'))"
        },
        "Build_Dev_Html": {
          "type": "Compose",
          "runAfter": { "Compute_ImpactLabel": ["Succeeded"] },
          "inputs": "@concat('<div class=\"dev-item\"><div class=\"dev-header\">', outputs('Compute_CategoryBadge'), ' ', outputs('Compute_ImpactLabel'), '</div><p class=\"dev-title\">', items('Build_Development_Items')?['title'], '</p><p class=\"dev-meta\">Source: ', items('Build_Development_Items')?['source'], ' &nbsp;&middot;&nbsp; ', items('Build_Development_Items')?['publishedAt'], '</p><p class=\"dev-body\">', items('Build_Development_Items')?['description'], '</p></div>')"
        },
        "Append_Dev_Item": {
          "type": "AppendToStringVariable",
          "runAfter": { "Build_Dev_Html": ["Succeeded"] },
          "inputs": { "name": "devItemsHtml", "value": "@outputs('Build_Dev_Html')" }
        }
      }
    },

    "Build_Event_Items": {
      "type": "Apply_to_each",
      "foreach": "@triggerBody()?['events']",
      "runAfter": { "Build_Development_Items": ["Succeeded"] },
      "actions": {
        "Build_Event_Html": {
          "type": "Compose",
          "inputs": "@concat('<div class=\"event-item\"><div class=\"event-date-box\"><span class=\"ev-month\">', substring(items('Build_Event_Items')?['date'], 0, 3), '</span><span class=\"ev-day\">', substring(items('Build_Event_Items')?['date'], 4, 2), '</span></div><div class=\"event-details\"><p class=\"ev-title\">', items('Build_Event_Items')?['title'], '</p><p class=\"ev-location\">', items('Build_Event_Items')?['location'], '</p><p class=\"ev-desc\">', coalesce(items('Build_Event_Items')?['description'], ''), '</p></div></div>')"
        },
        "Append_Event_Item": {
          "type": "AppendToStringVariable",
          "runAfter": { "Build_Event_Html": ["Succeeded"] },
          "inputs": { "name": "eventItemsHtml", "value": "@outputs('Build_Event_Html')" }
        }
      }
    },

    "Fallback_Empty_Events": {
      "type": "Compose",
      "runAfter": { "Build_Event_Items": ["Succeeded"] },
      "inputs": "@if(empty(variables('eventItemsHtml')), '<p class=\"no-events\">No community events scheduled in the next 14 days.</p>', variables('eventItemsHtml'))"
    },

    "Compute_RE_PriceClass": {
      "type": "Compose",
      "runAfter": { "Fallback_Empty_Events": ["Succeeded"] },
      "inputs": "@if(greaterOrEquals(triggerBody()?['realEstateSnapshot']?['priceChangePct'], 0), 're-up', 're-down')"
    },

    "Compute_RE_PriceChange": {
      "type": "Compose",
      "runAfter": { "Compute_RE_PriceClass": ["Succeeded"] },
      "inputs": "@concat(if(greaterOrEquals(triggerBody()?['realEstateSnapshot']?['priceChangePct'], 0), '+', ''), string(triggerBody()?['realEstateSnapshot']?['priceChangePct']), '% vs yesterday')"
    },

    "Compute_RE_ListingsClass": {
      "type": "Compose",
      "runAfter": { "Compute_RE_PriceChange": ["Succeeded"] },
      "inputs": "@if(greaterOrEquals(triggerBody()?['realEstateSnapshot']?['listingsChangePct'], 0), 're-up', 're-down')"
    },

    "Compute_RE_ListingsChange": {
      "type": "Compose",
      "runAfter": { "Compute_RE_ListingsClass": ["Succeeded"] },
      "inputs": "@concat(if(greaterOrEquals(triggerBody()?['realEstateSnapshot']?['listingsChangePct'], 0), '+', ''), string(triggerBody()?['realEstateSnapshot']?['listingsChangePct']), '% vs yesterday')"
    },

    "Inject_Template_Variables": {
      "type": "Compose",
      "runAfter": { "Compute_RE_ListingsChange": ["Succeeded"] },
      "inputs": {
        "step1":  "@replace('{{TEMPLATE_PLACEHOLDER}}',     '{{REPORT_DATE}}',        triggerBody()?['reportDate'])",
        "step2":  "@replace(outputs('Inject_Template_Variables')?['step1'],  '{{WINDOW_START}}',       triggerBody()?['windowStart'])",
        "step3":  "@replace(outputs('Inject_Template_Variables')?['step2'],  '{{WINDOW_END}}',         triggerBody()?['windowEnd'])",
        "step4":  "@replace(outputs('Inject_Template_Variables')?['step3'],  '{{GENERATED_AT}}',       coalesce(triggerBody()?['generatedAt'], utcNow()))",
        "step5":  "@replace(outputs('Inject_Template_Variables')?['step4'],  '{{DEV_COUNT}}',          string(length(triggerBody()?['developments'])))",
        "step6":  "@replace(outputs('Inject_Template_Variables')?['step5'],  '{{EXECUTIVE_SUMMARY}}',  triggerBody()?['executiveSummary'])",
        "step7":  "@replace(outputs('Inject_Template_Variables')?['step6'],  '{{DEVELOPMENT_ITEMS}}',  variables('devItemsHtml'))",
        "step8":  "@replace(outputs('Inject_Template_Variables')?['step7'],  '{{RE_MEDIAN_PRICE}}',    concat('$', string(triggerBody()?['realEstateSnapshot']?['medianListPrice'])))",
        "step9":  "@replace(outputs('Inject_Template_Variables')?['step8'],  '{{RE_PRICE_CLASS}}',     outputs('Compute_RE_PriceClass'))",
        "step10": "@replace(outputs('Inject_Template_Variables')?['step9'],  '{{RE_PRICE_CHANGE}}',    outputs('Compute_RE_PriceChange'))",
        "step11": "@replace(outputs('Inject_Template_Variables')?['step10'], '{{RE_ACTIVE_LISTINGS}}', string(triggerBody()?['realEstateSnapshot']?['activeListings']))",
        "step12": "@replace(outputs('Inject_Template_Variables')?['step11'], '{{RE_LISTINGS_CLASS}}',  outputs('Compute_RE_ListingsClass'))",
        "step13": "@replace(outputs('Inject_Template_Variables')?['step12'], '{{RE_LISTINGS_CHANGE}}', outputs('Compute_RE_ListingsChange'))",
        "step14": "@replace(outputs('Inject_Template_Variables')?['step13'], '{{RE_AVG_DAYS}}',        string(triggerBody()?['realEstateSnapshot']?['avgDaysOnMarket']))",
        "step15": "@replace(outputs('Inject_Template_Variables')?['step14'], '{{RE_NEW_CLASS}}',       're-up')",
        "step16": "@replace(outputs('Inject_Template_Variables')?['step15'], '{{RE_NEW_LISTINGS}}',    string(triggerBody()?['realEstateSnapshot']?['newListings24h']))",
        "step17": "@replace(outputs('Inject_Template_Variables')?['step16'], '{{EVENT_ITEMS}}',        outputs('Fallback_Empty_Events'))"
      }
    },

    "Respond_With_HTML": {
      "type": "Response",
      "runAfter": { "Inject_Template_Variables": ["Succeeded"] },
      "inputs": {
        "statusCode": 200,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "htmlBody":   "@outputs('Inject_Template_Variables')?['step17']",
          "devCount":   "@length(triggerBody()?['developments'])",
          "eventCount": "@length(triggerBody()?['events'])"
        }
      }
    }
  }
}
